{
  "schema": "auto_review_config/v1",
  "note": "Portable thresholds for the SOP step auto-review. No product-specific constants: every geometry input comes from plan/manifest/render artifacts at runtime.",
  "vlm": {
    "api_base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
    "api_key_env": "DASHSCOPE_API_KEY",
    "model": "qwen-vl-plus",
    "timeout_s": 60
  },
  "allowed_cameras": ["fixed_123", "fixed_456"],
  "checks": {
    "C6_camera_cosine_tol": 0.9995,
    "C6_scale_rel_tol": 0.15,
    "C7_center_tol_px": 20.0,
    "C7_center_tol_mm": 8.0,
    "C8_min_occupancy": 0.30,
    "C8_min_fill": 0.65,
    "C8_min_outline_fill": 0.25,
    "C9_arrow_loc_tol_mm": 3.0,
    "C3_translation_tol_mm": 0.5,
    "C9_min_ink_diff_px": 200,
    "ink_bg_delta": 25,
    "ink_label_exclude": {"row_frac": 0.72, "col_frac": 0.35},
    "c4_exempt_steps": []
  },
  "actions": {
    "C6": "manual",
    "C7": "rerender_step",
    "C8": "rerender_step",
    "C3": "rerun_plan_and_rerender",
    "C4": "rerun_plan_and_rerender",
    "C9": "redo_arrows",
    "V1": "manual",
    "V2": "manual",
    "V3": "rerender_step",
    "V5": "switch_camera_rerender",
    "V9": "redo_arrows"
  }
}
